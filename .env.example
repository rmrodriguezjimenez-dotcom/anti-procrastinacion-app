# Supabase (Browser-safe publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# OpenAI - server only
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_TASK_MODEL=gpt-5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# WhatsApp Cloud API - server only
WHATSAPP_ACCESS_TOKEN=YOUR_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
WHATSAPP_API_VERSION=v25.0
WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
